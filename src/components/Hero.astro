---
import Default from "@astrojs/starlight/components/Hero.astro";
import { LinkButton } from "@astrojs/starlight/components";

import Logo from "./Logo";
import RotatingText from "./Text";
import Background from "./Background";

const route = Astro.locals.starlightRoute;

const { actions } = route.entry.data.hero ?? {};
const isHomepage = route.id === "";
---

{
  isHomepage
      ? (
    <Background client:load />
    <div class="hero">
      <Logo className="logo" client:load />
      <p class="tagline">
        The{" "}
        <RotatingText
          className="text"
          staggerFrom={"last"}
          staggerDuration={0.025}
          rotationInterval={5000}
          texts={[
              "modern",
              "free",
              "hackable",
              "lightweight",
              "cross-platform",
              "open-source",
          ]}
          client:load
        />
        {" "}C++ webview library
      </p>
      {
        actions && actions.length > 0 && (
          <div class="sl-flex actions">
            {
              actions.map(
                  (
                      {
                          attrs: { class: className, ...attrs } = {},
                          icon,
                          link: href,
                          text,
                          variant,
                      },
                  ) => (
                <LinkButton
                  {href}
                  {variant}
                  icon={icon?.name}
                  class:list={[className]}
                  {...attrs}
                >
                  {text}
                  {icon?.html && <Fragment set:html={icon.html} />}
                </LinkButton>
              ),
              )
            }
          </div>
        )
      }
    </div>
  )
  : <Default><slot /></Default>
}

<style>
.hero {
  display: grid;
  align-items: center;
  margin-left: auto;
  margin-right: auto;
  gap: 1rem;
  padding-bottom: 1rem;
}

.hero :global(.logo) {
  width: min(70%, 20rem);
  height: auto;
  object-fit: contain;
  margin-inline: auto;
}

.tagline {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  white-space: preserve-spaces;
  font-weight: 500;
  font-size: 1.5rem;
  padding-bottom: 1rem;
}

.tagline .text {
  overflow: hidden;
  color: var(--sl-color-accent);
}

.actions {
  gap: 1rem 2rem;
  flex-wrap: wrap;
  justify-content: center;
}
</style>
